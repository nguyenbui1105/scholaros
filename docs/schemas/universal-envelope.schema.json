{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScholarOS Skill Envelope",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "inputs",
        "evidence_refs",
        "policy_context",
        "requested_at"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "student_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputs": {
          "type": "object"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy_context": {
          "type": "object"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "outputs",
        "evidence_refs",
        "uncertainties",
        "next_actions",
        "audit_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "needs_review",
            "rejected",
            "failed"
          ]
        },
        "outputs": {
          "type": "object"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ]
}
